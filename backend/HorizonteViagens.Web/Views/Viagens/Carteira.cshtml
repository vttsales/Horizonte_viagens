@* ALTERAÇÃO PIM: título acessível da área da conta. *@
@{ViewData["Title"]="Carteira de viagem";}
@model List<HorizonteViagens.Modelos.DocumentoViagem>
@* ALTERAÇÃO PIM: carteira usa apenas documentos efetivamente registrados no banco. *@
<section class="container section"><span class="eyebrow">TUDO JUNTO PARA EMBARCAR</span><h1>Minha carteira</h1><p>Passagens, hospedagens e ingressos das suas reservas confirmadas.</p><div class="reservation-grid">@foreach(var d in Model){<article class="document-card"><small>@d.Tipo</small><h2>@d.Titulo</h2><p>Localizador: @d.Codigo</p><a href="@d.Url" target="_blank" rel="noopener noreferrer">Abrir documento →</a></article>}</div>@if(Model.Count==0){<div class="empty-panel">Você ainda não possui documentos emitidos.</div>}</section>
