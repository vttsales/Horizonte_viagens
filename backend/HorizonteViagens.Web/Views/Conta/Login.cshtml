@model HorizonteViagens.Modelos.Dtos.LoginDto
@* ALTERAÇÃO PIM: formulário de cliente ou administrador, autenticado no servidor. *@
@{ViewData["Title"]="Entrar";var admin=(bool)(ViewData["Admin"]??false);}
<section class="auth-layout"><div class="auth-photo"><h1>O mundo chama.<br>Seu horizonte espera.</h1></div><div class="auth-content"><span class="eyebrow">@(admin?"GESTÃO HORIZONTE":"BEM-VINDO DE VOLTA")</span><h2>@(admin?"Entre na administração.":"Que bom ter você aqui.")</h2><form method="post"><input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]"><input type="hidden" name="admin" value="@admin.ToString().ToLowerInvariant()"><div asp-validation-summary="All" class="text-danger" role="alert"></div><label>E-mail<input asp-for="Email" class="form-control" autocomplete="username" required></label><label>Senha<input asp-for="Senha" class="form-control" autocomplete="current-password" required></label><button class="btn btn-dark w-100 mt-3">Entrar →</button></form>@if(!admin){<p class="mt-4">Ainda não tem conta? <a href="/Clientes/Criar">Cadastre-se</a></p>}<a href="/">← Voltar ao site</a></div></section>
