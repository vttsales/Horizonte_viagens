@* ALTERAÇÃO PIM: título acessível da área da conta. *@
@{ViewData["Title"]="Detalhes da reserva";}
@model HorizonteViagens.Modelos.Compra
@using HorizonteViagens.Modelos
@* ALTERAÇÃO PIM: pagamento sandbox separado da reserva e documentos só após emissão. *@
<section class="container section narrow"><a href="/Viagens">← Reservas</a><h1>@Model.NomePacote</h1><p>HV-@Model.Id · <strong>@Model.Status</strong></p><p>@Model.Viajantes adulto(s) · @Model.Quartos quarto(s) · @Model.Noites noites · @Model.Valor.ToString("C")</p>
@if(User.IsInRole("Cliente")){@if(Model.Status=="Pendente"){<div class="alert alert-info">Pagamento de teste: nenhuma cobrança real será realizada. A reserva fica pendente até a confirmação do serviço. Prazo: @Model.ExpiraEm.ToLocalTime().ToString("dd/MM HH:mm").</div><form method="post" asp-action="Pagar" asp-route-id="@Model.Id"><button class="btn btn-gold">Abrir pagamento de teste</button></form>@if(Model.PreferenciaId==null){<form method="post" asp-action="Cancelar" asp-route-id="@Model.Id" class="mt-3"><button class="btn btn-outline-danger">Cancelar reserva pendente</button></form>}}<form method="post" asp-action="Verificar" asp-route-id="@Model.Id" class="my-3"><button class="btn btn-outline-dark">Atualizar status do pagamento</button></form>}
<h2>Documentos da viagem</h2>@{var documentos=(List<DocumentoViagem>)ViewBag.Documentos;}@if(documentos.Count==0){<p>Os documentos aparecerão após a confirmação e emissão pela agência.</p>}@foreach(var d in documentos){<article class="document-card"><small>@d.Tipo</small><h3>@d.Titulo</h3><p>Localizador: @d.Codigo</p><a href="@d.Url" rel="noopener noreferrer" target="_blank">Abrir documento do fornecedor →</a></article>}
@if(User.IsInRole("Administrador")&&Model.Status=="Confirmada"){<h2>Adicionar documento emitido</h2><form method="post" asp-action="Emitir" asp-route-id="@Model.Id"><label>Tipo<input name="Tipo" required maxlength="40" class="form-control" placeholder="Passagem, hospedagem ou evento"></label><label>Título<input name="Titulo" required maxlength="140" class="form-control"></label><label>URL HTTPS do fornecedor<input name="Url" type="url" required maxlength="1000" class="form-control"></label><label>Código/localizador<input name="Codigo" required maxlength="100" class="form-control"></label><button class="btn btn-gold mt-3">Adicionar à carteira</button></form>}</section>
