@* ALTERAÇÃO PIM: navegação MVC com identidade Horizonte; busca e conta em destaque, seguindo padrões de portais de viagem. *@
<!DOCTYPE html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@ViewData["Title"] | Horizonte Viagens</title><link rel="icon" href="~/assets/favicon.svg"><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"><link rel="stylesheet" href="~/css/horizonte.css" asp-append-version="true"></head><body>
<a class="visually-hidden-focusable" href="#conteudo">Pular para o conteúdo</a>
<header class="site-header"><a class="marca" href="/">☀ <span>horizonte<small>VIAGENS</small></span></a><nav aria-label="Navegação principal"><a href="/Combos">Pacotes</a><a href="/#eventos">Eventos</a><a href="/#como-funciona">Como funciona</a></nav><div class="account-nav">@if(User.Identity?.IsAuthenticated==true){<a href="/Viagens">Minhas viagens</a><form action="/Conta/Sair" method="post">@Html.AntiForgeryToken()<button class="btn btn-outline-dark">Sair</button></form>}else{<a class="btn btn-dark" href="/Conta/Login">Entrar</a>}</div></header>
@if(User.Identity?.IsAuthenticated==true){<nav class="portal-nav" aria-label="Área da conta"><span>Olá, @User.Identity.Name</span><a href="/Viagens">Reservas</a>@if(User.IsInRole("Administrador")){<a href="/Combos/Gerenciar">Gerenciar combos</a><a href="/Clientes">Clientes</a>}else{<a href="/Viagens/Carteira">Carteira</a><a href="/Viagens/Favoritos">Favoritos</a><a href="/Conta/Perfil">Meu perfil</a>}</nav>}
<main id="conteudo">@if(TempData["Mensagem"] is string mensagem){<div class="container alert alert-success mt-3" role="status">@mensagem</div>}@if(TempData["Erro"] is string erro){<div class="container alert alert-danger mt-3" role="alert">@erro</div>}@RenderBody()</main>
<footer class="site-footer"><div><a class="marca" href="/">☀ horizonte</a><p>Passagem, hospedagem e eventos.<br>Uma viagem completa, em um só lugar.</p></div><div><a href="/Combos">Encontre seu destino</a><a href="/Conta/Login?admin=true">Administração</a><a href="/Home/Privacy">Privacidade</a></div><small>© @DateTime.Now.Year Horizonte Viagens</small></footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/horizonte.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
