@* ALTERAÇÃO PIM: quantidade de adultos acompanha busca, cards e reserva. *@
<form action="/Combos" method="get" class="travel-search"><div class="search-caption">✈ Passagem + hospedagem + evento</div><div class="search-row"><label>Destino ou evento<input name="destino" value="@ViewBag.Destino" placeholder="Para onde você quer ir?"></label><label>Categoria<select name="categoria"><option value="">Todas as experiências</option><option selected="@(ViewBag.Categoria=="Luxo")">Luxo</option><option selected="@(ViewBag.Categoria=="Econômico")">Econômico</option></select></label><label>Viajantes adultos<select name="viajantes" data-viajantes>@for(var n=1;n<=6;n++){<option value="@n" selected="@(n==(ViewBag.Viajantes??2))">@n @(n==1?"adulto":"adultos")</option>}</select></label><button class="btn btn-gold">Buscar pacotes →</button></div></form>
