@model List<HorizonteViagens.Modelos.Dtos.ComboDto>
@* ALTERAÇÃO PIM: o HTML da Horizonte passa a receber catálogo real do SQL por Razor. *@
@{ViewData["Title"]="Seu próximo horizonte";ViewBag.Viajantes=2;}
<section class="hero"><div><span class="eyebrow">NOVOS DESTINOS. GRANDES HISTÓRIAS.</span><h1>Seu destino é só<br>o <em>começo.</em></h1><p>Passagem, hospedagem e aquele evento que você quer viver.<br>A Horizonte reúne tudo na mesma viagem.</p><a href="#destinos" class="btn btn-gold">Encontre seu próximo horizonte →</a></div></section>
<div class="container search-overlap"><partial name="_Busca" /></div>
<section class="container section" id="destinos"><span class="eyebrow">VIAGENS COMPLETAS, DO SEU JEITO</span><div class="section-title"><div><h2>Qual história você quer viver?</h2><p>Compare o total para o seu grupo e conheça cada experiência.</p></div><a href="/Combos">Ver todos os pacotes →</a></div><div class="trip-grid">@foreach(var c in Model.Take(6)){<partial name="_Card" model="c" />}@if(Model.Count==0){<div class="empty-panel">Novos destinos estão a caminho. Consulte novamente em breve.</div>}</div></section>
<section class="events-band" id="eventos"><div class="container"><span class="eyebrow">O MOTIVO DA SUA PRÓXIMA VIAGEM</span><h2>Não vá só para conhecer.<br>Vá para viver.</h2><div class="event-grid">@foreach(var c in Model.Where(c=>!string.IsNullOrWhiteSpace(c.Evento))){<a class="event-card" href="/Combos/Detalhes/@c.Id"><img src="/assets/@(c.Imagem).jpg" alt=""><span><small>@c.Destino</small><strong>@c.Evento</strong></span></a>}</div></div></section>
<section class="container section" id="como-funciona"><span class="eyebrow">DO PLANEJAMENTO AO EMBARQUE</span><h2>Sua viagem, organizada.</h2><div class="steps-grid"><article><b>01</b><h3>Escolha seu combo</h3><p>Confira transporte, hospedagem, eventos e o total para os viajantes.</p></article><article><b>02</b><h3>Reserve sua saída</h3><p>Entre na sua conta e reserve as vagas disponíveis na data do pacote.</p></article><article><b>03</b><h3>Leve tudo com você</h3><p>Acompanhe a reserva e os documentos emitidos pelo site ou aplicativo.</p></article></div></section>
