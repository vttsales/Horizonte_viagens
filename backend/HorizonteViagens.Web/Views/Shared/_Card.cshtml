@model HorizonteViagens.Modelos.Dtos.ComboDto
@* ALTERAÇÃO PIM: preço composto e total por grupo; tarifas de referência nunca viram disponibilidade garantida. *@
@{var n=(int)(ViewBag.Viajantes??2);var total=(Model.Valor+Model.ValorExperiencias)*n+Model.DiariaQuarto*Model.Noites*((n+1)/2);}
<article class="trip-card" data-combo data-pessoa="@((Model.Valor+Model.ValorExperiencias).ToString(System.Globalization.CultureInfo.InvariantCulture))" data-quarto="@((Model.DiariaQuarto*Model.Noites).ToString(System.Globalization.CultureInfo.InvariantCulture))"><div class="trip-image"><img src="/assets/@(Model.Imagem).jpg" alt="Paisagem de @Model.Destino" loading="lazy"><span>@Model.Categoria</span></div><div class="trip-body"><small>@(Model.Noites+1) dias / @Model.Noites noites · @Model.Origem</small><h2>@Model.Destino</h2><p class="trip-event">@Model.Evento</p><p class="included">✈ Transporte &nbsp; ▤ Hospedagem &nbsp; ♫ Evento</p><p class="departure">@(Model.Partida?.ToString("dd/MM/yyyy")??"Próximas saídas sob consulta")</p><div class="trip-price"><small>@(Model.PrecoConfirmado?"Total do grupo":"Total estimado") · <span data-quantidade>@n</span> adulto(s)</small><strong data-total>@total.ToString("C",System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</strong><small><span data-unitario>@((total/n).ToString("C",System.Globalization.CultureInfo.GetCultureInfo("pt-BR")))</span> por pessoa</small></div><a class="btn btn-dark w-100" data-detalhes href="/Combos/Detalhes/@Model.Id?viajantes=@n">Ver pacote →</a></div></article>
