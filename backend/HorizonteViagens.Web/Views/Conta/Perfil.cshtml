@model HorizonteViagens.Modelos.Dtos.ClienteSalvarDto
@* ALTERAÇÃO PIM: perfil sem campo de ativação nem troca administrativa de senha. *@
<section class="container section narrow"><h1>Meu perfil</h1><form method="post"><div asp-validation-summary="All" class="text-danger"></div><div class="form-grid">@foreach(var campo in new[]{"Nome","Email","Cpf","Celular","Cep","Rua","Bairro","Cidade"}){<label>@campo @Html.TextBox(campo,null,new{@class="form-control"})</label>}</div><button class="btn btn-gold mt-3">Salvar dados</button></form></section>
