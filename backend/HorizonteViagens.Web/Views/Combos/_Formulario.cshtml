@model HorizonteViagens.Modelos.Dtos.ComboSalvarDto
@* ALTERAÇÃO PIM: componentes do preço e condições de publicação iguais aos da API. *@
<div asp-validation-summary="All" class="text-danger" role="alert"></div><input asp-for="Versao" type="hidden"><div class="form-grid">
<label>Nome<input asp-for="Nome" class="form-control" required maxlength="100"></label><label>Destino<input asp-for="Destino" class="form-control" required maxlength="100"></label><label>Origem<input asp-for="Origem" class="form-control" required maxlength="100"></label><label>Categoria<select asp-for="Categoria" class="form-select"><option>Luxo</option><option>Econômico</option></select></label><label>Evento<input asp-for="Evento" class="form-control" maxlength="140"></label><label>Partida<input asp-for="Partida" type="date" class="form-control"></label><label>Noites<input asp-for="Noites" type="number" min="1" max="60" class="form-control"></label><label>Vagas para adultos<input asp-for="Vagas" type="number" min="0" class="form-control"></label><label>Transporte/serviços por adulto (R$)<input asp-for="Valor" class="form-control" inputmode="decimal"></label><label>Diária por quarto de até 2 adultos (R$)<input asp-for="DiariaQuarto" class="form-control" inputmode="decimal"></label><label>Experiências por adulto (R$)<input asp-for="ValorExperiencias" class="form-control" inputmode="decimal"></label><label>Imagem<select asp-for="Imagem" class="form-select">@foreach(var imagem in new[]{"paris","tokyo","newyork","beach","coast","hero"}){<option>@imagem</option>}</select></label></div><label class="d-block">Descrição<textarea asp-for="Descricao" class="form-control" maxlength="2000"></textarea></label><label class="d-block">Inclusões (uma por linha)<textarea asp-for="Inclusoes" rows="4" class="form-control" maxlength="2000"></textarea></label><label class="d-block my-3"><input asp-for="Publicado"> Publicar na vitrine</label><label class="d-block my-3"><input asp-for="PrecoConfirmado"> Preço e serviços confirmados com os fornecedores</label><p class="price-note">Só marque a confirmação quando a oferta tiver data futura e condições válidas. Esta confirmação libera a reserva das vagas cadastradas.</p><button class="btn btn-gold" type="submit">Salvar combo</button> <a asp-action="Gerenciar" class="btn btn-outline-dark">Cancelar</a>
